<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="sort-only" default-locale="en-GB">
  <info>
    <title>Alphabetic labels (biblatex "alphabetic"-like), talk template</title>
    <id>talk-alphabetic</id>
    <author><name>talk Quarto extension</name></author>
    <category citation-format="label"/>
    <updated>2026-10-29T00:00:00+00:00</updated>
  </info>
  <macro name="authors">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " initialize-with=". " delimiter=", " and="symbol" delimiter-precedes-last="always"/>
      <substitute><names variable="editor"/></substitute>
    </names>
  </macro>
  <macro name="container">
    <group delimiter=", ">
      <text variable="container-title" font-style="italic" text-case="title"/>
      <group delimiter="">
        <text variable="volume"/>
        <text variable="issue" prefix="(" suffix=")"/>
      </group>
      <text variable="page" prefix="pp. "/>
      <text variable="publisher"/>
    </group>
  </macro>
  <citation>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-label"/>
    </layout>
  </citation>
  <bibliography>
    <sort><key variable="citation-label"/></sort>
    <layout>
      <text variable="citation-label" prefix="[" suffix="] "/>
      <text macro="authors"/>
      <date variable="issued" prefix=" (" suffix=")."><date-part name="year"/></date>
      <text variable="title" prefix=" " suffix="." text-case="title"/>
      <text macro="container" prefix=" "/>
      <text variable="URL" prefix=" "/>
      <text variable="note" prefix=" (" suffix=")"/>
    </layout>
  </bibliography>
</style>
